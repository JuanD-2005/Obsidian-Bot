# ---------------------------------------------------------------------------
# Obsidian AI Agent — environment variables
# Copy this file to .env and fill in your values.
# ---------------------------------------------------------------------------

# Absolute path to your Obsidian vault root
OBSIDIAN_VAULT_PATH=/home/user/ObsidianVault

# Path to the folder that holds Markdown templates (absolute, or relative to vault)
TEMPLATES_PATH=/home/user/ObsidianVault/Templates

# Output folder where generated notes are saved (absolute, or relative to vault)
OUTPUT_PATH=/home/user/ObsidianVault/Generated

# Default AI provider to use when --provider is not passed on the CLI.
# Accepted values: "openai" | "ollama"
DEFAULT_AI_PROVIDER=ollama

# --- OpenAI (only required when provider=openai) --------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Ollama (only required when provider=ollama) --------------------------
# Base URL of your local Ollama instance
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
